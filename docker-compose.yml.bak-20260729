services:
  postgresql:
    image: postgres:18-alpine
    container_name: temporal-postgresql
    restart: unless-stopped
    environment:
      POSTGRES_USER: temporal
      POSTGRES_PASSWORD: temporal
      POSTGRES_DB: temporal
    volumes:
      # postgres 18+ images expect the mount at /var/lib/postgresql (data
      # lives in a major-version subdir, enabling in-place pg_upgrade)
      - temporal-postgres-data:/var/lib/postgresql
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "temporal"]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - temporal-net

  temporal-schema-setup:
    image: temporalio/admin-tools:1.31.2
    container_name: temporal-schema-setup
    depends_on:
      postgresql:
        condition: service_healthy
    environment:
      SQL_USER: temporal
      SQL_PASSWORD: temporal
      SQL_HOST: postgresql
      SQL_PORT: 5432
      SQL_PLUGIN: postgres12
    command: >
      sh -c "temporal-sql-tool --db temporal create || true &&
             temporal-sql-tool --db temporal setup-schema -v 0.0 || true &&
             temporal-sql-tool --db temporal update-schema -d /etc/temporal/schema/postgresql/v12/temporal/versioned &&
             temporal-sql-tool --db temporal_visibility create --defaultdb temporal || true &&
             temporal-sql-tool --db temporal_visibility setup-schema -v 0.0 || true &&
             temporal-sql-tool --db temporal_visibility update-schema -d /etc/temporal/schema/postgresql/v12/visibility/versioned"
    networks:
      - temporal-net

  temporal:
    image: temporalio/server:1.31.2
    container_name: temporal
    restart: unless-stopped
    depends_on:
      temporal-schema-setup:
        condition: service_completed_successfully
    entrypoint: ["sh", "-c", "touch /tmp/dynamicconfig.yaml && exec /etc/temporal/entrypoint.sh"]
    environment:
      DB: postgres12
      DB_PORT: "5432"
      POSTGRES_USER: temporal
      POSTGRES_PWD: temporal
      POSTGRES_SEEDS: postgresql
      DYNAMIC_CONFIG_FILE_PATH: /tmp/dynamicconfig.yaml
    ports:
      - "7233:7233"
    networks:
      - temporal-net

  temporal-namespace-setup:
    image: temporalio/admin-tools:1.31.2
    container_name: temporal-namespace-setup
    depends_on:
      - temporal
    command: >
      sh -c "until temporal --address temporal:7233 operator cluster health | grep -q SERVING; do
               echo 'Waiting for Temporal server to start...' &&
               sleep 1;
             done &&
             temporal --address temporal:7233 operator namespace create --retention 168h default || true"
    networks:
      - temporal-net

  temporal-ui:
    image: temporalio/ui:2.52.1
    container_name: temporal-ui
    restart: unless-stopped
    depends_on:
      - temporal
    environment:
      TEMPORAL_ADDRESS: temporal:7233
      TEMPORAL_CORS_ORIGINS: http://localhost:8233
    ports:
      - "8233:8080"
    networks:
      - temporal-net

  # Orchestrator worker: workflows + persistence activities, 24/7.
  # Game-driving activities do NOT run here — they run on the host worker
  # (uv run python workers/worker.py), which needs the real desktop session.
  worker:
    build: .
    container_name: satisfactory-worker
    restart: unless-stopped
    # Run as the host user so files created on the ./stats bind mount
    # (SQLite gift history) stay writable from the host.
    user: "1000:1000"
    depends_on:
      temporal-namespace-setup:
        condition: service_completed_successfully
    environment:
      TEMPORAL_ADDRESS: temporal:7233
      HOME: /tmp
    volumes:
      # SQLite gift history + session stats land on the host
      - ./stats:/app/stats
      - ./workflows:/app/workflows
      - ./config.toml:/app/config.toml
    networks:
      - temporal-net

volumes:
  temporal-postgres-data:

networks:
  temporal-net:
    driver: bridge
